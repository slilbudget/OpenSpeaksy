<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.openspeaksy</string>
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_ROOT__/venv/bin/python</string>
        <string>__PROJECT_ROOT__/main.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>MISTRAL_API_KEY</key>
        <string>__MISTRAL_API_KEY__</string>
        <key>MISTRAL_MODEL</key>
        <string>voxtral-small-transcribe-3</string>
        <key>MISTRAL_TRANSLATION_MODEL</key>
        <string>mistral-large-4</string>
        <key>OPENSPEAKSY_DICTATE_LANGUAGE</key>
        <string></string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart on a crash or a launchctl stop, but NOT after a clean exit:
         a fatal misconfiguration exits 0 on purpose, and relaunching it every
         ThrottleInterval would only spin. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardOutPath</key>
    <string>/tmp/openspeaksy.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/openspeaksy.log</string>
</dict>
</plist>
